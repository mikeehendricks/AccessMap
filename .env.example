# Copy to .env and fill in (install.sh generates a 256-bit SECRET_KEY automatically).
SECRET_KEY=replace-with-openssl-rand-hex-32
REQUIRE_SECRET_KEY=1
DATABASE_URL=data/accessmap.db
HOST=127.0.0.1
PORT=5000
DEBUG=0
COOKIE_SECURE=0
GEO_LOOKUP_ENABLED=1
# Optional: set canonical external URL used in firewall forwarding snippets
# PUBLIC_BASE_URL=https://accessmap.example.com
